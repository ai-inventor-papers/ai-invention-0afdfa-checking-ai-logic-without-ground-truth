\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Stress test on Qwen 2.5 7B: seed-only accuracy rises by $+0.07$ on average under artificial internal-inconsistency, while the GRM-estimated $\theta $ drops by $-1.382$ across three random seeds with standard deviation 0.007. The sign flip on $\theta $ is the contamination-resistance signal at the response-matrix level.\relax }}{13}{figure.caption.8}\protected@file@percent }
\newlabel{fig:fig4}{{4}{13}{Stress test on Qwen 2.5 7B: seed-only accuracy rises by $+0.07$ on average under artificial internal-inconsistency, while the GRM-estimated $\theta $ drops by $-1.382$ across three random seeds with standard deviation 0.007. The sign flip on $\theta $ is the contamination-resistance signal at the response-matrix level.\relax }{figure.caption.8}{}}
